{
  "name": "dsh-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地多供应商 LLM 网关：复用 dsh-codearts-auth 的认证/协议层，把 CodeBuddy / WorkBuddy / Trae / Qoder 等包装成 OpenAI 兼容 API",
  "scripts": {
    "start": "tsx src/main.ts",
    "check": "bash scripts/typecheck.sh && bash scripts/selfcheck.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "sync-vendor": "bash scripts/sync-vendor.sh",
    "selfcheck": "bash scripts/selfcheck.sh"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "jose": "^6.2.8",
    "tsx": "^4.19.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "5.9.3"
  }
}
